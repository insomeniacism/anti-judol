# ==============================================================================
# anti-judol-hunter Environment Configuration
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Supabase PostgreSQL Connection String (Use Transaction/Session Pooler or Direct URI)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# LLM Multi-Provider Router (konsep 9router)
# Isi key provider mana saja yang kamu punya. Semua yang terisi digilir round-robin;
# provider yang kena 429 diistirahatkan otomatis & request pindah ke provider lain.
# Cek semua key dengan:  uv run anti-judol llm-check
# ------------------------------------------------------------------------------
# Groq        https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Cerebras    https://cloud.cerebras.ai  (API Keys)
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# Gemini      https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# OpenRouter  https://openrouter.ai/settings/keys  (openrouter/free = auto-pilih model gratis)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# GitHub Models: lokal pakai `gh auth token`; di Actions otomatis pakai GITHUB_TOKEN
GHMODELS_API_KEY=
# GHMODELS_MODEL=openai/gpt-4.1-mini
# Mistral     https://console.mistral.ai/api-keys  (plan "Experiment" gratis)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# Zhipu GLM   https://open.bigmodel.cn  (glm-4-flash gratis)
ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4-flash
# NVIDIA NIM  https://build.nvidia.com
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Provider custom lain (Cloudflare, SiliconFlow, Ollama lokal, 9router lokal, dll.) - JSON array:
# LLM_PROVIDERS=[{"name":"siliconflow","base_url":"https://api.siliconflow.cn/v1","api_key":"...","model":"Qwen/Qwen2.5-7B-Instruct","rpm":30}]
LLM_PROVIDERS=

# Legacy single provider (mis. DeepSeek panitia saat lomba) - ikut digilir bila LLM_API_KEY diisi
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Router tuning
LLM_COOLDOWN_SECONDS=30
LLM_MAX_WAIT_SECONDS=45
# Putus halaman judol yang sangat jelas tanpa memanggil LLM (hemat kuota)
KEYWORD_PREFILTER=true

# Optional: URLScan.io API Key (free tier gives higher rate limits, works without key too)
URLSCAN_API_KEY=

# Worker & Verifier Tuning
WORKER_ID=local-pc
VERIFY_BATCH_SIZE=30
VERIFY_CONCURRENCY=10
HTTP_TIMEOUT_SECONDS=12
AI_CONFIDENCE_THRESHOLD=0.70
LOCK_TIMEOUT_MINUTES=15
